---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { HOME } from '../../content/home';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'Down Payment Aid by County 2026: who publishes it and why';
const description = 'Down Payment Aid by County is published by Radif Partners: 2026 HUD limits for every county, state programs read at the source, no email asked, no lender paid.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About Down Payment Aid by County</h1>
    <p>{AUTHOR_DESC.en}</p>
    <h2>Why this site exists</h2>
    <p>Someone who searches for down payment assistance mostly finds three kinds of pages. Lead forms promise "matched programs" and show them only after you hand over your name, email and phone number. Lender and broker articles list programs in general terms, say that "income limits apply" without the figure for your county, and end with a button to get pre-approved. Agency pages are accurate but each covers one state, often in a PDF, and none turns the rules into an amount and a payment for your household.</p>
    <p><strong>{HOME.en.valeur}</strong></p>
    <h2>Who publishes it</h2>
    <p>The site is published by {AUTHOR_NAME}, a company that builds calculators from public data. It is not a public body and has no link with HUD, FHA, FHFA, any state housing finance agency, any lender or any real estate brokerage. It takes no commission, refers no one, asks for no name or email and carries no affiliate link.</p>
    <LegalIdentity lang={lang} />
    <h2>Where the figures come from</h2>
    <p><Fragment set:html={s('hud-il', 'HUD fiscal year 2026 income limits')} /> for county medians and 80% limits, <Fragment set:html={s('fhfa-cll', 'FHFA 2026 conforming loan limits')} />, <Fragment set:html={s('fha-ml', 'HUD Mortgagee Letter 2025-23')} /> for FHA limits, <Fragment set:html={s('pmms', 'the Freddie Mac weekly rate survey')} />, and the program pages and guides of each state housing finance agency, read one by one. The <a href={route('method', lang)}>method page</a> sets out every rule; the <a href={route('editorial', lang)}>editorial policy</a> explains how corrections are made.</p>
    <h2>What the site does not do</h2>
    <p>It does not take applications and cannot reserve funds. It does not know whether a program's yearly money has run out today: it shows the status the agency published. It cannot read your income documents or your credit report. Its answer is an estimate that an approved lender confirms or corrects.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, to report an error, a program that changed or an agency page we have not read.</p>
  </article>
</PageLayout>
