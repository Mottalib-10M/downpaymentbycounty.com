---
/** The calculator of a page: a declarative calculator of tool-specs.ts, sent with its starting state's figures. */
import SpecTool from './calc/SpecTool';
import { route } from '../i18n/routes';
import { preloadFor } from '../lib/states-server';
import type { Lang } from '../lib/format';
interface Props { kind: string; lang: Lang; arg?: Record<string, number | string>; idPrefix?: string }
const { kind, lang, arg, idPrefix = 't' } = Astro.props;
const preload = preloadFor(kind, lang, arg);
---
<SpecTool client:load kind={kind} lang={lang} arg={arg ? JSON.stringify(arg) : undefined} methodHref={route('method', lang)} idPrefix={idPrefix} preload={preload} />
